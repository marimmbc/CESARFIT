/* GymFlow - modelo estrategico e tatico (Context Mapper) */

ContextMap GymFlowMapa {
  type = SYSTEM_LANDSCAPE
  state = TO_BE
  contains MatriculaContext, FinanceiroContext, TreinoContext, AtendimentoContext, OperacaoContext, AcessoContext

  MatriculaContext [U,OHS]->[D,ACL] FinanceiroContext
  MatriculaContext [U,OHS]->[D,CF] TreinoContext
  MatriculaContext [U,OHS]->[D,CF] AcessoContext
  TreinoContext [U,OHS]->[D,CF] AtendimentoContext
  MatriculaContext [U,OHS]->[D,CF] AtendimentoContext
  // Integracoes por eventos de dominio (Published Language):
  OperacaoContext [U,PL]->[D,CF] AtendimentoContext   // EquipamentoInterditado / EquipamentoLiberado
  TreinoContext [U,PL]->[D,CF] AtendimentoContext     // DorRelatada
  FinanceiroContext [U,PL]->[D,CF] MatriculaContext   // ContestacaoJulgadaProcedente
  MatriculaContext [U,PL]->[D,CF] TreinoContext       // MatriculaEfetivada
}

Domain Academia {
  Subdomain GestaoDeMatriculas { type = CORE_DOMAIN domainVisionStatement = "Alunos, planos, matriculas, renovacao, cancelamento e avisos de vencimento" }
  Subdomain Financeiro { type = SUPPORTING_DOMAIN domainVisionStatement = "Pagamentos, estornos e contestacoes de cobranca" }
  Subdomain Treinamento { type = CORE_DOMAIN domainVisionStatement = "Catalogo de exercicios, fichas, presenca e feedback pos-treino" }
  Subdomain AtendimentoAoAluno { type = SUPPORTING_DOMAIN domainVisionStatement = "Avaliacao fisica, substituicao de exercicio e atendimento do instrutor" }
  Subdomain OperacaoDaAcademia { type = SUPPORTING_DOMAIN domainVisionStatement = "Problemas de equipamentos" }
  Subdomain ControleDeAcesso { type = GENERIC_SUBDOMAIN domainVisionStatement = "Login, sessao e senha" }
}

BoundedContext MatriculaContext implements GestaoDeMatriculas {
  Aggregate Alunos {
    Entity Aluno {
      aggregateRoot
      String nome
      - Cpf cpf
      String telefone
      String email
      Date dataDeNascimento
      - Objetivo objetivo
    }
    ValueObject Cpf { String numero }
    enum Objetivo { HIPERTROFIA, EMAGRECIMENTO, CONDICIONAMENTO }
  }
  Aggregate Matriculas {
    Entity Matricula {
      aggregateRoot
      Long alunoId
      - Modalidade modalidade
      BigDecimal valorMensal
      Date inicio
      Date fim
      - StatusMatricula status
      - List<Pagamento> pagamentos
      String justificativaDoCancelamento
      Date dataDaSolicitacaoDeCancelamento
      BigDecimal taxaDeCancelamento
    }
    ValueObject Pagamento {
      BigDecimal valor
      Date data
      String formaDePagamento
      boolean estornado
      String motivoDoEstorno
      Date dataDoEstorno
      - Dinheiro valorEstornado
      - MotivoDeEstorno categoriaDoEstorno
      def Dinheiro saldoEstornavel();
      - Dinheiro multa
      - Dinheiro juros
      int parcelas
      - Dinheiro troco
    }
    enum MotivoDeEstorno { COBRANCA_DUPLICADA, VALOR_INCORRETO, DESISTENCIA, CONTESTACAO_PROCEDENTE, OUTRO }
    enum FormaDePagamento { PIX, DINHEIRO, CARTAO_DEBITO, CARTAO_CREDITO, BOLETO }
    DomainEvent MatriculaEfetivada { Long matriculaId Long alunoId String plano Date inicio Date fim }
    enum Modalidade { MENSAL, ANUAL }
    // Matricula (raiz): creditoDeTroca, trancadaDe, trancadaAte, diasTrancados, trancamentos
    // def Pagamento registrarPagamento(Dinheiro valor, FormaDePagamento forma, int parcelas, Date hoje);
    // def Dinheiro valorDevido(Date hoje);  def void trancar(int dias, Date hoje);  def int destrancar(Date hoje);
    enum StatusMatricula { ATIVA, VENCIDA, CANCELADA }
  }
  Aggregate Notificacoes {
    Entity NotificacaoDeVencimento {
      aggregateRoot
      Long matriculaId
      Long alunoId
      Date vencimento
      - EtapaDeAviso etapa
      Date enviadaEm
      String mensagem
      boolean lida
      def static EtapaDeAviso etapaDevida(@Matricula matricula, Date hoje, Set<EtapaDeAviso> jaEnviadas, boolean outraVigente);
    }
    enum EtapaDeAviso { LEMBRETE, PROXIMO_DO_VENCIMENTO, VENCE_HOJE, VENCIDA, ULTIMO_AVISO }
  }
}

BoundedContext FinanceiroContext implements Financeiro {
  Aggregate Contestacoes {
    Entity ContestacaoDeCobranca {
      aggregateRoot
      Long matriculaId
      Long alunoId
      int indiceDoPagamento
      String valor
      String motivo
      - StatusContestacao status
      String parecer
      String analista
      String valorEstornado
      String pergunta
      String respostaDoAluno
      int pedidosDeInformacao
      String justificativaDoRecurso
      boolean recursoUsado
      def void pedirInformacoes(String pergunta);
      def void responder(String resposta);
      def Dinheiro analisar(StatusContestacao resultado, Dinheiro valorParcial, String parecer, String analista);
      def void recorrer(String justificativa);
      def boolean atrasada(Date agora);
    }
    DomainEvent ContestacaoJulgadaProcedente { Long contestacaoId Long matriculaId int indiceDoPagamento - Dinheiro valor String resultado String parecer }
    enum StatusContestacao { ABERTA, AGUARDANDO_ALUNO, PROCEDENTE, PARCIALMENTE_PROCEDENTE, IMPROCEDENTE, EM_RECURSO }
  }
}

BoundedContext TreinoContext implements Treinamento {
  Aggregate Catalogo {
    Entity Exercicio {
      aggregateRoot
      String nome
      - GrupoMuscular grupoMuscular
      String equipamento
      boolean ativo
    }
    enum GrupoMuscular { PEITO, COSTAS, PERNAS, OMBROS, BRACOS, CORE, CARDIO }
  }
  Aggregate Fichas {
    Entity FichaDeTreino {
      aggregateRoot
      Long alunoId
      Date criadaEm
      Date validaAte
      - List<ItemDeTreino> itens
    }
    Entity ItemDeTreino {
      String exercicio
      int series
      int repeticoes
      int descansoEmSegundos
      String divisao
      boolean concluido
    }
  }
  Aggregate Frequencia {
    Entity Presenca { aggregateRoot Long alunoId Date data }
    Entity FeedbackDeTreino {
      aggregateRoot
      Long alunoId
      Long fichaId
      Date data
      int esforco
      String observacao
      int duracaoMinutos
      boolean dor
      String localDaDor
      - AlertaDeCarga alerta
      def int carga(); // sRPE = esforco x duracao
    }
    DomainEvent DorRelatada { Long feedbackId Long alunoId String localDaDor }
    enum AlertaDeCarga { DOR_RELATADA, RISCO_DE_LESAO, SOBRECARGA, PROGRESSAO_SUGERIDA, NENHUM }
    Service AnaliseDeCarga {
      Resultado analisar(List<@FeedbackDeTreino> anteriores, @FeedbackDeTreino atual, Date hoje); // ACWR = aguda/cronica
    }
  }
}

BoundedContext AtendimentoContext implements AtendimentoAoAluno {
  Aggregate Avaliacoes {
    Entity SolicitacaoDeAvaliacao {
      aggregateRoot
      Long alunoId
      Date dataDesejada
      Date dataProposta
      Date dataAgendada
      - StatusAvaliacao status
      int propostasFeitas
      - ResultadoDeAvaliacao resultado
      Date realizadaEm
      def void recusarProposta();
      def void registrarResultado(@ResultadoDeAvaliacao medidas, Date agora);
      def void registrarFalta(Date agora);
    }
    ValueObject ResultadoDeAvaliacao {
      double pesoKg
      double alturaM
      Double percentualDeGordura
      def BigDecimal imc();
      def String classificacao();
    }
    enum StatusAvaliacao { SOLICITADA, NOVO_HORARIO_PROPOSTO, CONFIRMADA, REALIZADA, NAO_COMPARECEU, CANCELADA }
  }
  Aggregate Substituicoes {
    Entity SolicitacaoDeSubstituicao {
      aggregateRoot
      Long alunoId
      Long fichaId
      int posicao
      String exercicioAtual
      String exercicioNovo
      String motivo
      - MotivoDeSubstituicao categoria
      - StatusSolicitacao status
      boolean automatica
      def StatusSolicitacao statusEm(Date agora); // EXPIRADA apos 7 dias pendente
    }
    enum MotivoDeSubstituicao { DOR_OU_LESAO, EQUIPAMENTO_INDISPONIVEL, DIFICULDADE_TECNICA, PREFERENCIA }
    enum StatusSolicitacao { PENDENTE, APROVADA, REJEITADA, EXPIRADA }
  }
  Aggregate Atendimentos {
    Entity SolicitacaoDeAtendimento {
      aggregateRoot
      Long alunoId
      Long fichaId
      String motivo
      String instrutor
      String orientacao
      - TipoDeAtendimento tipo
      - StatusAtendimento status
      Date assumidoEm
      int transferencias
      Integer nota
      String comentario
      boolean automatico
      def void transferir(String novoInstrutor);
      def void cancelar();
      def void avaliar(int nota, String comentario, Date agora);
      def boolean atrasado(Date agora);
    }
    // Visao propria alimentada por eventos do OperacaoContext:
    // Repository RepositorioDeEquipamentosIndisponiveis { marcarIndisponivel(String); liberar(String); boolean indisponivel(String); }
    enum TipoDeAtendimento { DUVIDA_EXECUCAO, AJUSTE_DE_EQUIPAMENTO, DOR_OU_LESAO, OUTRO }
    enum StatusAtendimento { ABERTO, EM_ATENDIMENTO, CONCLUIDO, CANCELADO }
  }
}

BoundedContext OperacaoContext implements OperacaoDaAcademia {
  Aggregate Equipamentos {
    Entity OcorrenciaDeEquipamento {
      aggregateRoot
      String equipamento
      String descricao
      String solucao
      - Severidade severidade
      - StatusOcorrencia status
      Date inicioDoSla
      long minutosPausados
      String pecaAguardada
      - Dinheiro custoDoReparo
      int reaberturas
      boolean reincidente
      def void aguardarPeca(String peca, Date agora);
      def void retomar(Date agora);
      def void reabrir(String motivo, Date agora);
      def Date prazoDoSla(Date agora);
      def boolean interditado();
    }
    enum Severidade { BAIXA, MEDIA, ALTA, CRITICA }
    DomainEvent EquipamentoInterditado { Long ocorrenciaId String equipamento String severidade }
    DomainEvent EquipamentoLiberado { Long ocorrenciaId String equipamento }
    enum StatusOcorrencia { ABERTA, EM_ANDAMENTO, AGUARDANDO_PECA, RESOLVIDA }
  }
}

BoundedContext AcessoContext implements ControleDeAcesso {
  Aggregate Credenciais {
    Entity Credencial {
      aggregateRoot
      String login
      Long alunoId
      - Perfil perfil
      String senhaCodificada
    }
    enum Perfil { ALUNO, EQUIPE }
    ValueObject TentativasDeAcesso { int falhas Date bloqueadoAte } // 5 falhas = 15 min de bloqueio
  }
}
